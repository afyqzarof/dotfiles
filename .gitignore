# The bare repo itself (avoids recursion if cloned into $HOME)
.cfg

# macOS
.DS_Store

# Neovim (LazyVim): per-machine lockfile and starter cruft
.config/nvim/lazy-lock.json
.config/nvim/tt.*
.config/nvim/.tests
.config/nvim/doc/tags
.config/nvim/debug
.config/nvim/.repro
.config/nvim/foo.*
.config/nvim/*.log
.config/nvim/data

# tmux plugins are installed by TPM
.config/tmux/plugins/
